<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Event.
    -->
    <changeSet id="20260815153303-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="community_id"
                                 baseTableName="event"
                                 constraintName="fk_event__community_id"
                                 referencedColumnNames="id"
                                 referencedTableName="community"
                                 />

        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="event"
                                 constraintName="fk_event__category_id"
                                 referencedColumnNames="id"
                                 referencedTableName="community"
                                 />

        <addForeignKeyConstraint baseColumnNames="created_by_id"
                                 baseTableName="event"
                                 constraintName="fk_event__created_by_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="cancelled_by_id"
                                 baseTableName="event"
                                 constraintName="fk_event__cancelled_by_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />
    </changeSet>
</databaseChangeLog>
