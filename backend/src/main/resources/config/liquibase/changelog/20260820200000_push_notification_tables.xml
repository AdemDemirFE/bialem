<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260820200000-1" author="bialem">
        <createTable tableName="push_device_token">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="varchar(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_push_device_token_token"/>
            </column>
            <column name="platform" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseColumnNames="user_id"
            baseTableName="push_device_token"
            constraintName="fk_push_device_token_user_id"
            referencedColumnNames="id"
            referencedTableName="jhi_user"/>

        <createIndex
            indexName="idx_push_device_token_user_id"
            tableName="push_device_token">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260820200000-2" author="bialem">
        <createTable tableName="app_notification">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="varchar(2000)"/>
            <column name="notification_type" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_id" type="varchar(120)"/>
            <column name="route" type="varchar(500)"/>
            <column name="is_read" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="read_at" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint
            baseColumnNames="user_id"
            baseTableName="app_notification"
            constraintName="fk_app_notification_user_id"
            referencedColumnNames="id"
            referencedTableName="jhi_user"/>

        <createIndex
            indexName="idx_app_notification_user_created"
            tableName="app_notification">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex
            indexName="idx_app_notification_user_unread"
            tableName="app_notification">
            <column name="user_id"/>
            <column name="is_read"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
