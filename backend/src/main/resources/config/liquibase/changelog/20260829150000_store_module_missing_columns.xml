<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Store modülünde mevcut veritabanlarında eksik kalan kolonları
        idempotent olarak ekler. Changelog 20260829140000_store_module.xml
        içinde bu kolonlar zaten tanımlıdır; bu dosya eski/parçalı şemalar
        için güvenlik amacıyla tutulmaktadır.
    -->

    <changeSet id="20260829150000-1" author="bialem">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="store_product" columnName="barcode"/>
            </not>
        </preConditions>
        <addColumn tableName="store_product">
            <column name="barcode" type="varchar(120)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260829150000-2" author="bialem">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="store_category" columnName="created_by"/>
            </not>
        </preConditions>
        <addColumn tableName="store_category">
            <column name="created_by" type="varchar(80)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260829150000-3" author="bialem">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="store_category" columnName="updated_by"/>
            </not>
        </preConditions>
        <addColumn tableName="store_category">
            <column name="updated_by" type="varchar(80)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
