<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260829120100-1" author="bialem">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists constraintName="ux_story_view__story_viewer" tableName="story_view"/>
            </not>
        </preConditions>
        <addUniqueConstraint
            columnNames="story_id, viewer_id"
            constraintName="ux_story_view__story_viewer"
            tableName="story_view"
        />
    </changeSet>
</databaseChangeLog>
