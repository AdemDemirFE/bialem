<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="20260829120601-1" author="bialem">
        <addForeignKeyConstraint baseColumnNames="order_item_id"
                                 baseTableName="ticket"
                                 constraintName="fk_ticket__order_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="order_item"
                                 />
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="ticket"
                                 constraintName="fk_ticket__user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="profile"
                                 />
        <addForeignKeyConstraint baseColumnNames="event_id"
                                 baseTableName="ticket"
                                 constraintName="fk_ticket__event_id"
                                 referencedColumnNames="id"
                                 referencedTableName="event"
                                 />
        <createIndex indexName="idx_ticket_user_id" tableName="ticket">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_ticket_event_id" tableName="ticket">
            <column name="event_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
