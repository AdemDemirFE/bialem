<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is scoped to temporary Android VPS test hosts only.
  Production API (https://api.bialem.app) does not need cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Capacitor androidScheme=http → Origin http://localhost -->
        <domain includeSubdomains="false">localhost</domain>
        <!-- Temporary VPS Spring Boot HTTP API -->
        <domain includeSubdomains="false">191.215.36.29</domain>
    </domain-config>
</network-security-config>
