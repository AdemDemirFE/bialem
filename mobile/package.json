{
  "name": "bialem-mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "brand-assets": "npx @capacitor/assets generate --android --pwa --assetPath resources --iconBackgroundColor '#2A1878' --iconBackgroundColorDark '#1A1048' --splashBackgroundColor '#2A1878' --splashBackgroundColorDark '#1A1048' --logoSplashScale 0.42",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-router-dom": "^7.8.0",
    "sweetalert2": "^11.22.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.2",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "kleur": "^4.1.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
