{
  "name": "bialem-mobile",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "1:dev": "node ../scripts/run-mobile-vite.mjs --mode=development",
    "1:dev:proxy": "node ../scripts/run-mobile-vite.mjs --mode=development --proxy",
    "2:prod": "vite build --mode production",
    "3:android-test": "vite build --mode android-test",
    "dev": "npm run 1:dev",
    "web": "npm run 1:dev",
    "build": "npm run 2:prod",
    "build:android:test": "npm run 3:android-test",
    "android:1:dev": "vite build --mode development && node ../scripts/cap-sync-android.mjs",
    "android:2:prod": "npm run 2:prod && node ../scripts/cap-sync-android.mjs",
    "android:3:test": "npm run 3:android-test && node ../scripts/cap-sync-android.mjs --android-test",
    "android": "npm run android:2:prod && npx cap open android",
    "android:test": "npm run android:3:test",
    "preview": "vite preview --host --port 4173",
    "brand-assets": "npx @capacitor/assets generate --android --pwa --assetPath resources --iconBackgroundColor '#2A1878' --iconBackgroundColorDark '#1A1048' --splashBackgroundColor '#2A1878' --splashBackgroundColorDark '#1A1048' --logoSplashScale 0.42",
    "ios:2:prod": "npm run 2:prod && npx cap sync ios",
    "ios:3:test": "npm run 3:android-test && npx cap sync ios",
    "ios:test": "npm run ios:3:test && npx cap open ios",
    "ios": "npm run ios:2:prod && npx cap open ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/push-notifications": "^7.0.7",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-router-dom": "^7.8.0",
    "sweetalert2": "^11.22.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.2",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "kleur": "^4.1.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
