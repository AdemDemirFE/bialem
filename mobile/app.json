{
  "expo": {
    "name": "Bi Alem",
    "owner": "canexpo1",
    "slug": "bialem",
    "description": "Toplulukları, etkinlikleri ve yeni insanları bir araya getiren sosyal keşif uygulaması.",
    "scheme": "bialem",
    "version": "1.0.2",
    "icon": "./resources/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.bialem.app",
      "associatedDomains": [
        "applinks:bialem.app"
      ]
    },
    "android": {
      "package": "com.bialem.app",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./resources/icon.png",
        "backgroundColor": "#2A1878"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bialem.app",
              "pathPrefix": "/event-share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14b08b32-6d6a-428f-87eb-32272589af6b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "color": "#7b35ff",
          "defaultChannel": "events"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Etkinlikleri takviminize ekleyebilmek için takvim erişimi gereklidir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Etkinlik mekânını haritadan seçebilmek için konumunuza erişim gereklidir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Etkinlik giriş QR kodlarını tarayabilmek için kameraya erişim gereklidir.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "./plugins/withBlockedAndroidPermissions",
      "./plugins/withBialemAndroidTheme"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/14b08b32-6d6a-428f-87eb-32272589af6b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
