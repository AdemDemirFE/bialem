# Local development only. Copy to .env.dev if you want a root checklist.
# Runtime files the apps actually read:
#   mobile/.env
#   admin/.env.local
# Backend uses Spring profile "dev" (application-dev.yml), not this file.
#
# Do not put production passwords, JWT, or api.bialem.app here.

BIALEM_ENV=dev

# Local Docker Postgres from backend/src/main/docker/postgresql.yml
# Host port 15432 — isolated from any production DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=bialem
POSTGRES_USER=bialem
POSTGRES_PASSWORD=

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/bialem
SPRING_DATASOURCE_USERNAME=bialem
SPRING_DATASOURCE_PASSWORD=

VITE_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
