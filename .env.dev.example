# Client API targets (edit in package.json → bialem.environments; used by mobile/admin):
#   npm run 1:dev          → http://191.215.36.29:8080
#   npm run 2:prod         → https://api.bialem.app
#   npm run 3:android-test → http://191.215.36.29:8080
#
# App version: package.json "version" + bialem.versionCode
#
# Backend itself uses Spring profile (dev/prod), not Vite modes.
# Local: application-dev.yml + Postgres localhost:15432
# VPS:   .env.prod + SPRING_PROFILES_ACTIVE=prod

BIALEM_ENV=dev

# Local Docker Postgres from backend/src/main/docker/postgresql.yml
# Host port 15432 — isolated from any production DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=bialem
POSTGRES_USER=bialem
POSTGRES_PASSWORD=

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/bialem
SPRING_DATASOURCE_USERNAME=bialem
SPRING_DATASOURCE_PASSWORD=

VITE_API_BASE_URL=http://191.215.36.29:8080
NEXT_PUBLIC_API_BASE_URL=http://191.215.36.29:8080

# Local SMTP (Gmail). Use Google App Password — not your normal Gmail password.
# IMPORTANT: Spring does NOT load this file. Copy to gitignored `.env.dev` OR use
# `backend/src/main/resources/config/application-mail-local.yml` (gitignored).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=acbaldirlioglu@gmail.com
MAIL_PASSWORD=
MAIL_FROM=acbaldirlioglu@gmail.com
# Reset links open here (admin web bridge locally):
JHIPSTER_MAIL_BASE_URL=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
