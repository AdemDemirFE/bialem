# ============================================================================
# BIALEM BACKEND — CENTRAL CONFIGURATION
# ============================================================================
# Copy this file to config.env and fill in your values.
# NEVER commit config.env to git — it contains secrets.
#
# Usage:
#   cp config.env.example config.env
#   # Edit config.env with your real values
#   ./deploy.sh build      # Build Docker image
#   ./deploy.sh up         # Start services
#   ./deploy.sh down       # Stop services
#   ./deploy.sh status     # Check status
#   ./deploy.sh logs       # Tail logs
#   ./deploy.sh migrate    # Run Liquibase migrations only
#   ./deploy.sh seed-admin # Create admin user
# ============================================================================

# ─── Application ────────────────────────────────────────────────────────
APP_NAME=bialem
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ─── Database ───────────────────────────────────────────────────────────
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=bialem
POSTGRES_USER=bialem
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# For local development, POSTGRES_HOST should be localhost and PORT 5432

SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SPRING_LIQUIBASE_URL=${SPRING_DATASOURCE_URL}
SPRING_LIQUIBASE_USER=${SPRING_DATASOURCE_USERNAME}
SPRING_LIQUIBASE_PASSWORD=${SPRING_DATASOURCE_PASSWORD}

# ─── JWT (REQUIRED — generate with: openssl rand -base64 64) ───────────
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ─── Mail ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@bialem.app

# ─── Frontend URLs ──────────────────────────────────────────────────────
FRONTEND_URL=https://bialem.app
# Comma-separated list of allowed CORS origins for mobile + web
# Mobile apps use capacitor://localhost or http://localhost
JHIPSTER_CORS_ALLOWED_ORIGINS=https://bialem.app,https://www.bialem.app,http://localhost,capacitor://localhost
JHIPSTER_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://localhost:*

# ─── Firebase (Push Notifications) ─────────────────────────────────────
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Path to Firebase service account JSON file (mounted as volume)
FIREBASE_CREDENTIALS=/app/config/firebase-service-account.json

# ─── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Payment (iyzico) ──────────────────────────────────────────────────
PAYMENT_PROVIDER=MOCK
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_BASE_URL=https://sandbox-api.iyzipay.com
PAYMENT_WEBHOOK_SECRET=

# ─── Java / JVM ─────────────────────────────────────────────────────────
JAVA_OPTS=-Xms256m -Xmx512m

# ─── Swagger / API Docs (disabled in production) ───────────────────────
SPRINGDOC_SWAGGER_UI_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false

# ─── Management ─────────────────────────────────────────────────────────
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=false

# ─── Liquibase Contexts ────────────────────────────────────────────────
# Comma-separated list: dev, prod, test
LIQUIBASE_CONTEXTS=prod
