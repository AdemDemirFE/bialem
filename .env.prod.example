# Production secrets for VPS Docker Compose only.
# Copy:  cp .env.prod.example .env.prod
# Fill CHANGE_ME, then:  ./deploy/scripts/deploy.sh
# Never copy these values into mobile/.env or application-dev.yml.

BIALEM_ENV=prod
COMPOSE_PROJECT_NAME=bialem

POSTGRES_DB=bialem
POSTGRES_USER=bialem
POSTGRES_PASSWORD=CHANGE_ME

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://bialem-db:5432/bialem
SPRING_DATASOURCE_USERNAME=bialem
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_LIQUIBASE_URL=jdbc:postgresql://bialem-db:5432/bialem
SPRING_LIQUIBASE_USER=bialem
SPRING_LIQUIBASE_PASSWORD=CHANGE_ME

# openssl rand -base64 64
# Use the SAME value for both JWT keys.
JWT_SECRET=CHANGE_ME
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=CHANGE_ME

JHIPSTER_MAIL_BASE_URL=https://bialem.app
JHIPSTER_CORS_ALLOWED_ORIGINS=https://bialem.app,https://www.bialem.app

SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Baked into the Vite image at docker build time.
VITE_API_BASE_URL=https://api.bialem.app
