# Production secrets for VPS Docker Compose only.
# Copy:  cp .env.prod.example .env.prod
# Fill CHANGE_ME, then:  ./deploy/scripts/deploy.sh
# Never copy these values into mobile/.env or application-dev.yml.

BIALEM_ENV=prod
COMPOSE_PROJECT_NAME=bialem

POSTGRES_DB=bialem
POSTGRES_USER=bialem
POSTGRES_PASSWORD=CHANGE_ME

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://bialem-db:5432/bialem
SPRING_DATASOURCE_USERNAME=bialem
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_LIQUIBASE_URL=jdbc:postgresql://bialem-db:5432/bialem
SPRING_LIQUIBASE_USER=bialem
SPRING_LIQUIBASE_PASSWORD=CHANGE_ME

# openssl rand -base64 64
# Use the SAME value for both JWT keys.
JWT_SECRET=CHANGE_ME
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=CHANGE_ME

JHIPSTER_MAIL_BASE_URL=http://191.215.36.29:8080
# Alias also accepted by Spring: FRONTEND_URL
# FRONTEND_URL=https://bialem.app
# Capacitor Android WebView origin is https://localhost (default androidScheme).
# iOS / older WebViews may send capacitor://localhost or http://localhost.
# Exact origins (Capacitor + production web). Port-specific Vite origins need the pattern below.
JHIPSTER_CORS_ALLOWED_ORIGINS=https://bialem.app,https://www.bialem.app,https://localhost,http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,capacitor://localhost
JHIPSTER_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://localhost:*

# SMTP (provider-agnostic). Gmail example values are documented in the password-reset summary.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=acbaldirlioglu@gmail.com
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=acbaldirlioglu@gmail.com
# Optional aliases: MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin SDK (FCM). JSON is not in git. Mount the file on the VPS.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=bialem-ac26c
FIREBASE_CREDENTIALS=/opt/bialem/secrets/firebase-service-account.json

# Baked into the Vite image at docker build time.
VITE_API_BASE_URL=https://api.bialem.app
VITE_PUBLIC_WEB_URL=https://bialem.app
