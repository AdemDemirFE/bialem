# Bialem backend env (systemd EnvironmentFile).
# .env.prod içindeki SPRING_/JHIPSTER_/FIREBASE_/OPENAI_ değerlerini birebir kopyalayın.
# Değerlerin içinde boşluk veya '#' olmamalıdır.
SPRING_PROFILES_ACTIVE=prod
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/bialem
SPRING_DATASOURCE_USERNAME=bialem
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_LIQUIBASE_URL=jdbc:postgresql://127.0.0.1:5432/bialem
SPRING_LIQUIBASE_USER=bialem
SPRING_LIQUIBASE_PASSWORD=CHANGE_ME
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
JHIPSTER_MAIL_BASE_URL=https://bialem.app
JHIPSTER_CORS_ALLOWED_ORIGINS=https://bialem.app,https://www.bialem.app,https://localhost,http://localhost:5173,capacitor://localhost
JHIPSTER_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://localhost:*
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=/opt/bialem/vps/secrets/firebase-service-account.json