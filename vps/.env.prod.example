# Bialem VPS package - production environment
# Setup: cp .env.prod.example .env.prod  then edit secrets (CHANGE_ME).
# Docker Compose reads this file via:  docker compose --env-file .env.prod up -d
# The .env.prod file is gitignored and contains secrets. Keep it on the server only.

BIALEM_ENV=prod
COMPOSE_PROJECT_NAME=bialem

# PostgreSQL (source of truth)
POSTGRES_DB=bialem
POSTGRES_USER=bialem
POSTGRES_PASSWORD=CHANGE_ME

# Spring Boot datasource / Liquibase (must match POSTGRES_*)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://bialem-db:5432/bialem
SPRING_DATASOURCE_USERNAME=bialem
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_LIQUIBASE_URL=jdbc:postgresql://bialem-db:5432/bialem
SPRING_LIQUIBASE_USER=bialem
SPRING_LIQUIBASE_PASSWORD=CHANGE_ME

# openssl rand -base64 64
# Use the SAME value for both JWT keys.
JWT_SECRET=CHANGE_ME
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=CHANGE_ME

JHIPSTER_MAIL_BASE_URL=http://127.0.0.1:8184
JHIPSTER_CORS_ALLOWED_ORIGINS=https://bialem.app,https://www.bialem.app,https://localhost,http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,capacitor://localhost
JHIPSTER_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://localhost:*

# SMTP
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false

# OpenAI (AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin SDK (FCM). JSON dosyası pakette yok; sunucuya koyun ve burayı işaret edin.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# Admin Next.js
ADMIN_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.bialem.app

# Host binding for the backend API (Docker host port 8184 -> container 8080).
# Default loopback: nginx on the host proxies api.bialem.app -> 127.0.0.1:8184.
# If you have no domain yet, set BACKEND_BIND=0.0.0.0 to expose http://<ip>:8184 directly.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8184

# Host binding for the frontend static site (nginx container port 80).
FRONTEND_PORT=4174